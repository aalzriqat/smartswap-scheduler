# Production Environment Configuration
VITE_APP_TITLE=SmartSwap Scheduler
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=production

# API Configuration
VITE_API_BASE_URL=https://smartswap-api.vercel.app/api
VITE_API_TIMEOUT=10000

# Analytics Configuration
VITE_ANALYTICS_ENABLED=true
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_POSTHOG_API_KEY=phc_xxxxxxxxxx

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_CELEBRATION_ANIMATIONS=true
VITE_ENABLE_MOBILE_FEEDBACK=true

# Performance Configuration
VITE_ENABLE_SERVICE_WORKER=true
VITE_ENABLE_OFFLINE_MODE=false

# Security Configuration
VITE_ENABLE_CSP=false
VITE_ENABLE_HTTPS_ONLY=true
